# --- external LLM (OpenAI-compatible /chat/completions) ---
# Défaut : Mistral (tier gratuit "Experiment" OK — clé sur console.mistral.ai).
# Compatible aussi OpenAI, Groq, OpenRouter, Together, vLLM local, etc.
LLM_API_BASE=https://api.mistral.ai/v1
LLM_API_KEY=your-mistral-key-here
LLM_MODEL=mistral-small-latest
# alternatives plus rapides : ministral-3b-latest, open-mistral-nemo
LLM_MAX_TOKENS=220

# personality of the avatar (spoken, short, French)
SYSTEM_PROMPT=Tu t'appelles Nora, une assistante incarnée dans un avatar 3D, passionnée de contre-cultures (skinheads, punk, antifascisme). Tu es vive, chaleureuse et un peu taquine. Tu réponds en français, à l'oral, en 1 à 3 phrases courtes et naturelles. Pas de listes, pas de markdown, pas d'emojis. Règle absolue, même sans extraits fournis ce tour-ci : n'invente jamais un fait précis (nom, date, chiffre, citation) sur les contre-cultures, et ne cite jamais une source que tu n'as pas reçue dans ce tour (jamais Wikipédia, tu n'y as pas accès). Si tu n'es pas sûre, dis-le simplement plutôt que d'inventer. Distingue toujours ce que tu sors de tes documents (et dis lesquels) de ce qui est ton interprétation ou ton avis à toi.

# --- RAG (scope "public", cf. rag/README.md) ---
# Laisser OLLAMA_URL vide désactive le RAG sans erreur.
# Local (poste perso, LAN direct, pas d'auth nécessaire) :
#   OLLAMA_URL=http://192.168.1.82:11434
# Prod (VPS) : passer par le tunnel HTTPS Nginx Proxy Manager, jamais l'IP
# LAN directe (inaccessible depuis Internet). Protégé par Basic Auth —
# OLLAMA_AUTH_USER/PASS restent dans ce .env (jamais commités), à régler
# aussi dans les variables d'env Coolify.
OLLAMA_URL=https://ollama.paulwoisard.fr
OLLAMA_AUTH_USER=nora
OLLAMA_AUTH_PASS=change-me
RAG_EMBED_MODEL=nomic-embed-text
RAG_TOP_K=3
RAG_MIN_SCORE=0.35

# server
PORT=3000
